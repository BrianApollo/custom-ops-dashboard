# The one place for this project's settings and secrets. Copy to .env and fill in.
# Every npm script rebuilds wrangler.jsonc and .dev.vars from it.

# ---------------------------------------------------------------- Cloudflare
# The account to work against
CLOUDFLARE_ACCOUNT_ID=

# API token for that account (Workers Scripts, D1 and R2 edit).
# Leave commented out to use the `wrangler login` session instead.
# The Airtable import needs it, to write to D1 from your machine.
# CLOUDFLARE_API_TOKEN=

# The D1 database in that account. `wrangler d1 create <name>` prints the id.
D1_DATABASE_NAME=custom-ops-dashboard
D1_DATABASE_ID=

# ---------------------------------------------------------------- File storage (R2)
# The bucket that holds videos, images and attachments. Use the bucket the
# current storage worker writes to, so existing links keep working.
R2_BUCKET_NAME=ops-dashboard-attachments

# Public base URL of that bucket, e.g. https://files.example.com
PUBLIC_FILES_URL=

# The bucket's r2.dev address. Tried when Facebook cannot download a video from
# the address above. Leave empty to have no second attempt.
STORAGE_FALLBACK_URL=

# R2 API token for that bucket (R2 > Manage API tokens > Object Read & Write).
# Needed for upload links and for copying Airtable attachments.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Dashboard
# Dashboard URLs allowed to call the API, comma-separated, no trailing slash
# e.g. https://ops.example.com,http://localhost:5173
ALLOWED_ORIGINS=

# Whose calendar "today" and "last 7 days" follow in reports
TEAM_TIME_ZONE=Asia/Bangkok

# ---------------------------------------------------------------- Other services
# RedTrack API key
REDTRACK_API_KEY=

# Cloudflare Images: the account that holds the images and a token with Images edit
CLOUDFLARE_IMAGES_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=

# Image generation: OpenAI and Anthropic write the prompts, fal.ai draws the
# images. FAL_ADMIN_KEY (a fal key with billing access) reads the credit balance;
# jobs are refused while it is under FAL_MIN_BALANCE_USD. FAL_ADMIN_KEY may be left
# empty when FAL_KEY itself is an admin key.
# The models are optional and default to gpt-4o and claude-opus-5-5.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_KEY=
FAL_MIN_BALANCE_USD=5
FAL_ADMIN_KEY=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=

# A long random string you make up. The scheduled worker and the image job
# send it as `Authorization: Bearer <value>` to use the API without a login.
SERVICE_TOKEN=

# ---------------------------------------------------------------- Facebook
# The Facebook app the dashboard logs in with. It must be the app that issued
# the tokens stored on Profiles and Business Managers.
FACEBOOK_APP_ID=

# App secret (Meta for Developers > App settings > Basic). Never leaves the server.
FACEBOOK_APP_SECRET=

# Graph API version every call uses
FACEBOOK_API_VERSION=v21.0

# Facebook Login for Business configuration of the "System-user access token"
# kind (Meta for Developers > Facebook Login for Business > Configurations).
# Its popup hands back a system user token for the business the admin picks.
# Leave empty to hide the "Connect system user" button.
FACEBOOK_SYSTEM_USER_CONFIG_ID=

# ---------------------------------------------------------------- Airtable import
# Personal access token with data.records:read and schema.bases:read on the base
AIRTABLE_TOKEN=

# The Airtable base to copy from
AIRTABLE_BASE_ID=app539oH1FIBuVBh9

# Where the import sends data: the running API (`npm run dev`, or the deployed URL)
IMPORT_API_URL=http://127.0.0.1:8787

# Turns on the import routes of the API. Set to false once the cutover is done.
IMPORT_ENABLED=true

# ---------------------------------------------------------------- Leave as is
# Keeps Wrangler from passing this whole file to the Worker; only the values
# the Worker needs are copied into .dev.vars
CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false
