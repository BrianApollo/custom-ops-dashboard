{
  "name": "@ops/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "config": "node scripts/generate-wrangler-config.mjs",
    "dev": "npm run config && wrangler dev",
    "deploy": "npm run config && npm run build -w @ops/frontend && wrangler deploy &&wrangler secret bulk .dev.vars",
    "types": "npm run config && wrangler types",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run config && wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@ops/shared": "*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.148.0"
  }
}
