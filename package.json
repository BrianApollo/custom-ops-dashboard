{
  "name": "ops-dashboard",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "scripts",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @ops/backend",
    "dev:frontend": "npm run dev -w @ops/frontend",
    "build": "npm run build -w @ops/frontend",
    "deploy": "npm run deploy -w @ops/backend",
    "import": "npm run import -w @ops/scripts --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "local:setup": "npm run local:setup -w @ops/backend",
    "local:dev": "npm run local:dev -w @ops/backend --",
    "local:reset": "npm run local:reset -w @ops/backend",
    "local:copy": "npm run local:copy -w @ops/backend --",
    "test": "npm test -w @ops/backend"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
